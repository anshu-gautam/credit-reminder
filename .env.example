# --- Gateway ---
AI_BUDGET_MONITOR_ENABLED=true
AI_GATEWAY_ENFORCEMENT_MODE=enforce   # enforce | dry_run

# --- Admin API auth (PRD §23) ---
# When set, every /api/admin/* request must send `Authorization: Bearer <token>`.
# Leave empty in local/dev to keep the dashboard explorable without setup.
ADMIN_API_TOKEN=

# --- Provider management / admin keys (server-side only) ---
OPENROUTER_MANAGEMENT_KEY=
OPENAI_ADMIN_KEY=
ANTHROPIC_ADMIN_KEY=

# --- Alert destinations ---
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=ops@example.com
PAGERDUTY_ROUTING_KEY=

# --- OpenRouter thresholds (USD) ---
OPENROUTER_WARN_USD=20
OPENROUTER_CRITICAL_USD=5
OPENROUTER_EMERGENCY_USD=1

# --- OpenAI thresholds ---
OPENAI_MONTHLY_BUDGET_USD=1000
OPENAI_WARN_PERCENT=70
OPENAI_CRITICAL_PERCENT=90
OPENAI_EMERGENCY_PERCENT=100

# --- Anthropic thresholds ---
ANTHROPIC_MONTHLY_BUDGET_USD=1000
ANTHROPIC_WARN_PERCENT=70
ANTHROPIC_CRITICAL_PERCENT=90
ANTHROPIC_EMERGENCY_PERCENT=100
